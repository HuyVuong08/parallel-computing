# Build rule for target.
atomicReduction-cuda: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 atomicReduction-cuda
.PHONY : atomicReduction-cuda

# fast build rule for target.
atomicReduction-cuda/fast:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/atomicReduction-cuda.dir/build.make CMakeFiles/atomicReduction-cuda.dir/build
.PHONY : atomicReduction-cuda/fast

