# Build rule for target.
segment-reduce-cuda: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 segment-reduce-cuda
.PHONY : segment-reduce-cuda

# fast build rule for target.
segment-reduce-cuda/fast:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/segment-reduce-cuda.dir/build.make CMakeFiles/segment-reduce-cuda.dir/build
.PHONY : segment-reduce-cuda/fast

